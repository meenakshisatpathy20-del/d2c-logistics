// D2C Logistics data model.
// Every business record carries brandId so the platform can serve many brands
// from day one; our own D2C business is simply the first brand.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Tenancy and people ----------

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users      User[]
  warehouses Warehouse[]
  orders     Order[]
  shipments  Shipment[]
  pickups    Pickup[]
  tasks      Task[]
  redFlags   RedFlag[]
  auditLogs  AuditLog[]
  notifications Notification[]
  summaries     DailySummary[]
}

enum Role {
  ADMIN
  OPS
  WAREHOUSE
  SUPPORT
  FINANCE
  VENDOR // vendor partner login, limited to its own warehouse
  COURIER // courier partner login, limited to its own courier's pickups
}

model User {
  id           String    @id @default(cuid())
  brandId      String
  brand        Brand     @relation(fields: [brandId], references: [id])
  name         String
  phone        String
  email        String?   @unique // sign-in: email + password, then a one-time code
  role         Role
  managerId    String?
  manager      User?     @relation("ManagerReports", fields: [managerId], references: [id])
  reports      User[]    @relation("ManagerReports")
  warehouseId  String? // set for VENDOR users
  courierCode  String? // set for COURIER users
  active       Boolean   @default(true)
  passwordHash String? // scrypt; mobile + password until SMS OTP is connected
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  ownedTasks Task[]    @relation("TaskOwner")
  ownedFlags RedFlag[] @relation("FlagOwner")
  challenges LoginChallenge[]
  notifications Notification[]

  @@unique([brandId, phone])
}

/// Step 2 of sign-in: a 6-digit code sent after the password is right.
model LoginChallenge {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// ---------- Places ----------

model Warehouse {
  id            String   @id @default(cuid())
  brandId       String
  brand         Brand    @relation(fields: [brandId], references: [id])
  code          String // e.g. WHFQFV, same IDs as the Velocity sheet
  name          String // e.g. Star India
  address       String
  city          String
  state         String
  pincode       String
  contactName   String
  contactPhone  String
  cluster       String? // pickup cluster, e.g. "Mumbai West - Malad"
  isRtoLocation Boolean  @default(true)
  createdAt     DateTime @default(now())

  pickupOrders Order[]  @relation("PickupWarehouse")
  rtoOrders    Order[]  @relation("RtoWarehouse")
  pickups      Pickup[]

  @@unique([brandId, code])
}

// ---------- Couriers ----------

enum CourierMode {
  DEMO
  LIVE
}

model Courier {
  code      String      @id // DELHIVERY, EKART, SHADOWFAX, BLUEDART, XPRESSBEES, AMAZON, BLITZ, PIKNDEL
  name      String
  mode      CourierMode @default(DEMO)
  active    Boolean     @default(true)
  isBackup  Boolean     @default(false)
  createdAt DateTime    @default(now())

  shipments Shipment[]
  pickups   Pickup[]
}

// ---------- Orders and shipments ----------

enum PaymentMode {
  PREPAID
  COD
}

enum OrderSource {
  MANUAL
  CSV
  OMS_GURU
  API
}

enum OrderStatus {
  NEW
  READY_TO_SHIP
  IN_TRANSIT
  DELIVERED
  NEEDS_ATTENTION
  RTO
  CANCELLED
}

model Order {
  id                String      @id @default(cuid())
  brandId           String
  brand             Brand       @relation(fields: [brandId], references: [id])
  orderNumber       String // order ID from OMS / store
  productBrand      String? // our brand: AccessHer, Hungama HiLife, Kasrat...
  source            OrderSource @default(MANUAL)
  status            OrderStatus @default(NEW)
  pickupWarehouseId String
  pickupWarehouse   Warehouse   @relation("PickupWarehouse", fields: [pickupWarehouseId], references: [id])
  rtoWarehouseId    String?
  rtoWarehouse      Warehouse?  @relation("RtoWarehouse", fields: [rtoWarehouseId], references: [id])

  customerName  String
  customerPhone String
  customerEmail String?
  addressLine   String
  city          String
  state         String
  pincode       String

  paymentMode   PaymentMode
  orderValue    Decimal     @db.Decimal(12, 2)
  codAmount     Decimal     @default(0) @db.Decimal(12, 2)
  codAdvance    Decimal     @default(0) @db.Decimal(12, 2) // paid online at checkout; the courier collects codAmount
  advanceStatus String? // PAID, ADJUSTED, FORFEITED, REFUNDED
  codConfirmed  Boolean? // null = not asked yet
  weightGrams   Int
  lengthCm      Int
  breadthCm     Int
  heightCm      Int
  items         Json // [{ name, sku, qty, price }]
  rtoRisk       Int? // 0-100, rule-based first
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  shipments Shipment[]
  messages  Message[]

  // Duplicate-booking lock: one order number per brand.
  @@unique([brandId, orderNumber])
  @@index([brandId, status])
  @@index([customerPhone])
}

enum ShipmentStatus {
  BOOKED
  PICKUP_SCHEDULED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  NDR
  RTO_INITIATED
  RTO_DELIVERED
  CANCELLED
}

model Shipment {
  id               String         @id @default(cuid())
  brandId          String
  brand            Brand          @relation(fields: [brandId], references: [id])
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id])
  courierCode      String
  courier          Courier        @relation(fields: [courierCode], references: [code])
  awb              String
  isDemo           Boolean        @default(true)
  status           ShipmentStatus @default(BOOKED)
  chargedAmount    Decimal        @db.Decimal(12, 2)
  chargedWeightG   Int
  courierWeightG   Int? // weight the courier measured at pickup; above chargedWeightG = weight dispute
  labelUrl         String?
  packingProofUrls String[]
  packedAt         DateTime? // vendor marked "packed and ready"
  photos           PackingPhoto[]
  expectedDelivery DateTime?
  etaDays          Int            @default(3)
  pickupId         String?
  pickup           Pickup?        @relation(fields: [pickupId], references: [id])
  lastScanAt       DateTime?
  idempotencyKey   String         @unique // a retried booking never creates a second shipment
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  events   TrackingEvent[]
  tasks    Task[]
  redFlags RedFlag[]

  @@unique([courierCode, awb])
  @@index([brandId, status])
}

model TrackingEvent {
  id         String         @id @default(cuid())
  shipmentId String
  shipment   Shipment       @relation(fields: [shipmentId], references: [id])
  status     ShipmentStatus
  location   String?
  remark     String?
  occurredAt DateTime
  receivedAt DateTime       @default(now())

  @@index([shipmentId, occurredAt])
}

// ---------- Pickups (slots, confirmation, reliability) ----------

enum PickupStatus {
  SCHEDULED
  CONFIRMED // courier confirmed an executive before the slot
  PICKED_UP
  MISSED
  POSTPONED
  REASSIGNED // moved to backup courier
  CANCELLED
}

model Pickup {
  id             String       @id @default(cuid())
  brandId        String
  brand          Brand        @relation(fields: [brandId], references: [id])
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id])
  courierCode    String
  courier        Courier      @relation(fields: [courierCode], references: [code])
  slotStart      DateTime
  slotEnd        DateTime
  status         PickupStatus @default(SCHEDULED)
  executiveName  String?
  executivePhone String?
  confirmedAt    DateTime?
  pickedUpAt     DateTime?
  missCount      Int          @default(0)
  parcelCount    Int          @default(0) // parcels booked into this slot, kept after a move
  movedToId      String? // set when the parcels moved to another pickup
  postponeReason String?
  missReason     String? // given by courier partner
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  shipments Shipment[]
  redFlags  RedFlag[]

  @@unique([warehouseId, courierCode, slotStart])
  @@index([brandId, slotStart])
}

// ---------- Ownership board, red flags, chat ----------

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model Task {
  id              String     @id @default(cuid())
  brandId         String
  brand           Brand      @relation(fields: [brandId], references: [id])
  shipmentId      String?
  shipment        Shipment?  @relation(fields: [shipmentId], references: [id])
  title           String
  type            String // PICKUP_MISSED, STUCK, NDR, CUSTOMER_REPLY, RCA, ...
  ownerId         String
  owner           User       @relation("TaskOwner", fields: [ownerId], references: [id])
  dueAt           DateTime
  status          TaskStatus @default(OPEN)
  escalationLevel Int        @default(0) // 0 owner, 1 manager, 2 courier KAM, 3 founder
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([brandId, status, dueAt])
}

enum FlagSeverity {
  WARNING
  CRITICAL
}

model RedFlag {
  id         String       @id @default(cuid())
  brandId    String
  brand      Brand        @relation(fields: [brandId], references: [id])
  shipmentId String?
  shipment   Shipment?    @relation(fields: [shipmentId], references: [id])
  pickupId   String?
  pickup     Pickup?      @relation(fields: [pickupId], references: [id])
  type       String // PICKUP_UNCONFIRMED, PICKUP_MISSED, NO_SCAN_48H, NDR, RTO
  severity   FlagSeverity
  title      String
  message    String
  ownerId    String?
  owner      User?        @relation("FlagOwner", fields: [ownerId], references: [id])
  dueAt      DateTime?
  action     String? // the one-tap fix shown in "Needs you"
  note       String? // what was done, e.g. 'RCA sent to Ekart'
  escalationLevel Int       @default(0) // 0 owner, 1 manager, 2 courier account manager, 3 founder
  escalatedAt     DateTime?
  actedAt    DateTime?
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())

  @@unique([type, shipmentId, pickupId])
  @@index([brandId, resolvedAt])
}

enum SenderType {
  CUSTOMER
  BRAND
  SYSTEM
}

model Message {
  id         String     @id @default(cuid())
  orderId    String
  order      Order      @relation(fields: [orderId], references: [id])
  senderType SenderType
  senderName String?
  body       String
  channel    String     @default("WEB") // WEB, WHATSAPP, SMS, EMAIL
  createdAt  DateTime   @default(now())

  @@index([orderId, createdAt])
}

// ---------- Audit ----------

model AuditLog {
  id         String   @id @default(cuid())
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id])
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([brandId, entityType, entityId])
}

// ---------- Alerts, messages and summaries ----------

enum Channel {
  APP // the bell in the app
  WHATSAPP
  SMS
  EMAIL
}

/// Every alert and message the platform sends. Until WhatsApp, SMS and email
/// accounts are approved, messages are kept here marked DEMO and not sent.
model Notification {
  id        String    @id @default(cuid())
  brandId   String
  brand     Brand     @relation(fields: [brandId], references: [id])
  userId    String? // set for team alerts (shows on that person's bell)
  user      User?     @relation(fields: [userId], references: [id])
  channel   Channel
  to        String // phone, email or name
  kind      String // FLAG, ESCALATION, DAILY_SUMMARY, VENDOR_PICKUPS, PICKUP_POSTPONED
  title     String
  body      String
  link      String? // opens the exact screen the alert is about
  status    String    @default("DEMO") // DEMO (kept, not sent), SENT, FAILED
  dedupeKey String?   @unique // the same alert is never sent twice
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([brandId, createdAt])
  @@index([userId, readAt])
}

/// The 9 pm summary for management, one per day.
model DailySummary {
  id        String   @id @default(cuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id])
  day       String // YYYY-MM-DD in IST
  data      Json
  createdAt DateTime @default(now())

  @@unique([brandId, day])
}

/// Packing proof: photos of the packed parcel, taken by the vendor at packing time.
model PackingPhoto {
  id           String   @id @default(cuid())
  shipmentId   String
  shipment     Shipment @relation(fields: [shipmentId], references: [id])
  mime         String
  data         Bytes
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([shipmentId])
}
